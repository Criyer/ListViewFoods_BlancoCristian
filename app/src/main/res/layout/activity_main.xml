<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/food_background"
    tools:context=".MainActivity">

    <!-- Listado de Comidas -->
    <ListView
        android:id="@+id/lvFoods"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSelectionStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra inferior que muestra la selección -->
    <TextView
        android:id="@+id/tvSelectionStatus"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@color/food_bottom_bar"
        android:gravity="center"
        android:text="@string/initial_selection"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/food_text_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>